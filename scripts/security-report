#!/usr/bin/env python3
"""Deduplicate complete Trivy reports; fail closed on any unresolved HIGH/CRITICAL."""
import argparse
import json
from pathlib import Path

RANK = {'UNKNOWN': 0, 'LOW': 1, 'MEDIUM': 2, 'HIGH': 3, 'CRITICAL': 4}


def summarize(paths):
    findings = {}
    if not paths:
        raise ValueError('No vulnerability reports supplied')
    for path in paths:
        report = json.loads(path.read_text())
        if report.get('SchemaVersion') != 2 or 'Results' not in report:
            raise ValueError(f'Invalid or incomplete scanner report: {path.name}')
        for result in report['Results'] or []:
            for v in result.get('Vulnerabilities') or []:
                ident = v['VulnerabilityID']
                row = findings.setdefault(ident, {'id': ident, 'severity': 'UNKNOWN',
                    'title': v.get('Title', ''), 'advisory': v.get('PrimaryURL', ''),
                    'disposition': 'review-required', 'exploitability': 'unverified', 'occurrences': []})
                severity = v['Severity']
                if RANK[severity] > RANK[row['severity']]:
                    row['severity'] = severity
                row['occurrences'].append({'report': path.name, 'target': result['Target'],
                    'package': v['PkgName'], 'installed': v['InstalledVersion'],
                    'fixed': v.get('FixedVersion') or None, 'status': v.get('Status'),
                    'evidence': 'installed-package-or-module-version'})
    return sorted(findings.values(), key=lambda x: (-RANK[x['severity']], x['id']))


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('reports', nargs='+', type=Path)
    p.add_argument('--output', required=True, type=Path)
    args = p.parse_args()
    try:
        rows = summarize(args.reports)
    except (ValueError, KeyError, OSError) as error:
        p.exit(2, str(error)+'\n')
    args.output.write_text(json.dumps({'findings': rows, 'automatic_exceptions': []}, indent=2)+'\n')
    counts = {severity: sum(r['severity'] == severity for r in rows) for severity in reversed(RANK)}
    print(json.dumps(counts))
    # Unfixed findings remain blocking until a separate, reviewed disposition exists.
    # This report does not automatically approve exceptions or infer reachability.
    return int(any(r['severity'] in ('HIGH', 'CRITICAL') for r in rows))


if __name__ == '__main__':
    raise SystemExit(main())
